# Ronin - Environment Variables
# Copy this to ~/.ronin/.env for optional integrations
# Or run `ronin setup` to configure interactively

# ===========================================
# AI Access
# ===========================================

# Ronin uses Codex authenticated with your ChatGPT account. No API key is
# stored here. Run `codex login` once if the setup check reports signed out.

# ===========================================
# Job Boards
# ===========================================

# Seek login
# Ronin uses an interactive Chrome session (cookies stored in a persistent
# Chrome profile under ~/.ronin/) rather than storing your credentials here.
# Run `ronin apply` once in a terminal to log in.

# Gmail outcome tracking uses OAuth Desktop credentials.
# Place OAuth JSON at ./credentials.json or configure tracking.gmail.credentials_path.
# The refresh token is stored at ~/.ronin/gmail_token.json after first auth.

# ===========================================
# Database (Optional)
# ===========================================

# Default backend is SQLite (~/.ronin/data/ronin.db). To use a remote Postgres DB:
# RONIN_DB_BACKEND=postgres
# RONIN_DATABASE_DSN=postgresql://user:password@host:5432/ronin

# ===========================================
# Notifications (Optional)
# ===========================================

# Slack webhook for job alerts
SLACK_WEBHOOK_URL=

# ===========================================
# Browser (Optional)
# ===========================================

# Override Chrome binary path (auto-detected if not set)
# CHROME_BINARY_PATH=/path/to/chrome
